# 复制本文件为 .env，并填入真实值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-你的key

# 可选：切换其他 OpenAI 兼容服务
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：真实业务 API（接订单/商品/物流系统时填写）
API_BASE_URL=
API_TOKEN=

# ---- 运行与可观测性（均有默认值，可留空） ----
# 服务名，用于日志 service 字段（默认 ecommerce-agent）
SERVICE_NAME=ecommerce-agent
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO
# 日志格式：json / text（默认 json；本地调试可用 text）
LOG_FORMAT=json

# ---- 运行时防护 ----
# 跨域白名单，逗号分隔；为空表示不启用 CORS（默认不放宽）
CORS_ALLOW_ORIGINS=
# 限流总开关、窗口秒数、每窗口最大请求数（默认 true / 60 / 120）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# 限流豁免路径（逗号分隔，默认健康检查）
RATE_LIMIT_EXCLUDE_PATHS=/health,/health/ready
# 请求体大小上限（字节，默认 64 KiB）
MAX_BODY_BYTES=65536

# ---- Redis 连接池与降级（阶段五基础设施；REDIS_URL 为空时全部走 SQLite/内存） ----
# 连接串示例：redis://localhost:6379/0；留空表示不使用 Redis
REDIS_URL=
# 读写超时与连接超时（秒，默认 1.0；缓存可丢失可重试，不应拖慢用户请求）
REDIS_SOCKET_TIMEOUT=1
REDIS_CONNECT_TIMEOUT=1
# 连接池最大连接数（默认 50；压测出现连接等待时再调大）
REDIS_MAX_CONNECTIONS=50
# redis-py 空闲连接探活间隔（秒，默认 30；0 表示关闭）
REDIS_HEALTH_CHECK_INTERVAL=30
# PING 结果缓存秒数（默认 5；避免每个请求入口都真 PING 放大 QPS）
REDIS_PING_CACHE_SECONDS=5
# Redis 不可达时是否回退 SQLite（默认 false：显式失败，避免数据分叉）
REDIS_FALLBACK_TO_MEMORY=false
# 多租户 Key 前缀（默认空：保持 chat:{sid} 不变；允许字母数字 _ - :，长度 <= 32）
REDIS_KEY_PREFIX=
# 历史消息 TTL（秒，默认 0=不过期；写入时刷新，读取不续期）
REDIS_SESSION_TTL_SECONDS=0
# 会话状态（最近路由/活跃时间）TTL（秒，默认 1800=30 分钟）
REDIS_SESSION_STATE_TTL_SECONDS=1800

# ---- Pending Store 后端（阶段五步骤 3；两阶段确认记录） ----
# 后端：auto / memory / redis。auto：无 REDIS_URL 用内存，有则用 Redis（不可达显式失败）
PENDING_STORE_BACKEND=auto
# confirm 分布式锁 TTL（秒，默认 10；必须大于写工具最坏耗时）
PENDING_LOCK_TTL_SECONDS=10
# pending 主记录 Redis TTL（秒，默认 3600；必须 >= 2 × CONFIRMATION_TTL_SECONDS）
PENDING_REDIS_TTL_SECONDS=3600

# ---- 归一化消息缓存（阶段五步骤 4；默认关闭） ----
# 总开关（默认 false；开启后命中会跳过 LLM 调用）
NMSG_CACHE_ENABLED=false
# 允许缓存的 Profile 白名单（逗号分隔；after_sales 涉及确认流程，默认排除）
NMSG_CACHE_ENABLED_PROFILES=pre_sales,order
# 默认 TTL（秒，默认 3600）
NMSG_TTL_SECONDS=3600
# order Profile 的 TTL（秒，默认 60；订单状态变化快）
NMSG_ORDER_TTL_SECONDS=60
# 归一化后消息的最小长度（默认 4；短消息不缓存）
NMSG_MIN_LENGTH=4
# 流式命中时按多少字符分块输出（默认 20）
NMSG_STREAM_CHUNK_SIZE=20

# ---- Langfuse 观测/评估（两个密钥都为空时自动 no-op） ----
# 自托管地址（v3 使用 LANGFUSE_BASE_URL）
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 总开关（默认 true；与密钥是否为空共同决定是否启用）
LANGFUSE_ENABLED=true

# ---- 上下文组装预算（近似 token 估算，详见 phase3-step-2-notes） ----
# 组装层保留的最大历史条数（默认 20；与 memory 存储上限独立）
CONTEXT_MAX_HISTORY=20
# 组装后 messages 的总 token 预算（默认 8000）
CONTEXT_MAX_TOTAL_TOKENS=8000
# 为模型输出预留的 token（默认 1500，估算值）
CONTEXT_RESERVE_COMPLETION=1500
# 无论如何保留的最近历史条数（默认 4）
CONTEXT_MIN_KEEP_RECENT=4
# 单条 user 消息字符上限（默认 4000）
CONTEXT_MAX_USER_CHARS=4000
# 稳定前缀是否纳入工具 schema（默认 true；阶段五语义缓存使用）
CONTEXT_STABLE_PREFIX=true

# ---- 工具循环策略（默认值与旧版 5 轮硬编码等价） ----
# 单请求最多 LLM 调用轮次（默认 5）
LOOP_MAX_STEPS=5
# 单请求最多工具调用次数（默认 20，必须 >= LOOP_MAX_STEPS）
LOOP_MAX_TOOL_CALLS=20
# 循环总时长上限，秒（默认 120，含 LLM 与工具耗时）
LOOP_TIMEOUT_SECONDS=120
# 外部中断检查开关（默认 false；阶段四多 Agent 注入探针时开启）
LOOP_ENABLE_INTERRUPT_CHECK=false

# ---- 写操作两阶段确认（apply_refund / cancel_order） ----
# pending 待确认记录的有效期（秒，默认 300）
CONFIRMATION_TTL_SECONDS=300
# 总开关（默认 true；设为 false 时写操作直接执行，用于应急回滚）
CONFIRMATION_ENABLED=true
# 单会话最多保留的 pending 条数（默认 5，超出时最旧的作废）
CONFIRMATION_MAX_PENDING_PER_SESSION=5
# 过期判断的时钟容差（秒，默认 5；只放宽“已过期”，用于吸收跨实例时钟跳变）
CONFIRMATION_CLOCK_SKEW_SECONDS=5

# ---- Retry / Fallback（默认关闭，显式开启才生效） ----
# 总开关（默认 false；开启后仅重试可重试错误）
RETRY_ENABLED=false
# 最多尝试次数（含首次，默认 3）
RETRY_MAX_ATTEMPTS=3
# 首次退避毫秒数（默认 300）
RETRY_INITIAL_BACKOFF_MS=300
# 单次退避上限毫秒（默认 5000）
RETRY_MAX_BACKOFF_MS=5000
# 指数退避因子（默认 2.0，必须 >= 1）
RETRY_BACKOFF_MULTIPLIER=2.0
# 抖动比例（默认 0.2，范围 0~1）
RETRY_JITTER_RATIO=0.2
# 是否重试 LLM 调用（默认 true，仅在总开关开启后生效）
RETRY_LLM=true
# 是否重试幂等读工具（默认 true；写操作永不重试）
RETRY_TOOLS=true
# LLM 重试耗尽后是否返回降级文本（默认 true）
RETRY_FALLBACK_ENABLED=true
# 降级回复文本（默认：系统繁忙，请稍后重试。）
RETRY_FALLBACK_TEXT=系统繁忙，请稍后重试。

# ---- Router 意图路由（阶段四；默认规则优先） ----
# 路由策略：rule_first / llm_first / rule_only / llm_only
ROUTER_STRATEGY=rule_first
# 置信度阈值（0~1，默认 0.55；低于该值会尝试 LLM 或采用规则低置信结果）
ROUTER_CONFIDENCE_THRESHOLD=0.55
# 兜底 Profile（默认 pre_sales：最常见且无写副作用）
ROUTER_DEFAULT_PROFILE=pre_sales
# LLM 路由总开关（默认 true；关闭后完全走规则+兜底）
ROUTER_LLM_ENABLED=true
# LLM 路由调用超时秒数（默认 5）
ROUTER_LLM_TIMEOUT_SECONDS=5

# ---- 离线评测（阶段六） ----
# 输入 token 单价（每千 token，默认 0 表示不计算成本）
# 成本口径由部署者按实际供应商定价填写，评测器不硬编码任何供应商价格
EVAL_INPUT_PRICE_PER_1K_TOKENS=0
# 输出 token 单价（每千 token，默认 0 表示不计算成本）
EVAL_OUTPUT_PRICE_PER_1K_TOKENS=0
# 评测随机种子（默认 42；记录在报告中用于复现）
EVAL_SEED=42
